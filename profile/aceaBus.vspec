# Bus-specific profile
# Remove signals not relevant for buses according to the ACEA FMS-Standard version 05 11.11.2025.
# The following sections define the specific signals to be removed for Buses.

Vehicle.Powertrain.CombustionEngine.EnginePercentLoadAtCurrentSpeed:
  delete: True

Vehicle.Service:
  type: branch
  delete: True

Vehicle.Powertrain.PowerTakeOffs:
  type: branch
  delete: True

Vehicle.GrossCombinationVehicleWeight:
  delete: True
