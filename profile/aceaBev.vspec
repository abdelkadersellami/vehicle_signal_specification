# Battery Electric Vehicle (BEV) specific profile
# Remove combustion engine, fuel system, and clutch pedal signals for BEVs
# The following sections define the specific signals to be removed for BEV Vehicles.

Vehicle.Powertrain.CombustionEngine:
  type: branch
  delete: True

Vehicle.Powertrain.FuelSystem:
  type: branch
  delete: True

Vehicle.Powertrain.Transmission.IsClutchPedalPressed:
  delete: True
